---
import Base from '../layouts/Base.astro';
import AppHeader from '../components/AppHeader.astro';
import BeanCard from '../components/BeanCard.astro';
import BrewCard from '../components/BrewCard.astro';
import WaterCard from '../components/WaterCard.astro';
import ElementsCard from '../components/ElementsCard.astro';
import SaveBar from '../components/SaveBar.astro';
import SavedView from '../components/SavedView.astro';
---

<Base
  title="Cold Brew Calculator"
  description="Cold brew ratios by bean, water and add-ons, with saved recipes."
>
  <div class="wrap">
    <AppHeader />

    <main id="view-calc" class="wrap">
      <div class="editing" id="editing" hidden>
        <span>Editing <b id="editing-name"></b></span>
        <button type="button" class="btn ghost" id="btn-new">New recipe</button>
      </div>
      <BeanCard />
      <BrewCard />
      <WaterCard />
      <ElementsCard />
    </main>

    <main id="view-saved" class="wrap" hidden>
      <SavedView />
    </main>
  </div>
  <SaveBar />
</Base>

<style>
  .editing { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: var(--pine-soft); border-radius: 12px; padding: 8px 8px 8px 14px; font-size: 14px; }
</style>

<script>
  import '../scripts/app';
</script>
