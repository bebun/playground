---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ground: #eef1ec;
    --surface: #ffffff;
    --ink: #1c2620;
    --muted: #5e6b63;
    --line: #d6ddd6;
    --tea: #46613f;
    --tea-soft: #e1e9dc;
    --pine: #9a6b06;
    --pine-strong: #b9820f;
    --pine-soft: #f6ecd2;
    --field: #f7f9f6;
    --focus: #b9820f;
    --warn-bg: #fbeee0;
    --warn-ink: #8a4b08;
    --on-accent: #ffffff;
    --font-display: 'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif;
    --font-body: 'IBM Plex Sans', 'Segoe UI', system-ui, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --ground: #141a16;
      --surface: #1c241f;
      --ink: #e6ece6;
      --muted: #9ba89f;
      --line: #2e3a33;
      --tea: #9dc08f;
      --tea-soft: #25331f;
      --pine: #e3b34a;
      --pine-strong: #e3b34a;
      --pine-soft: #3a2f14;
      --field: #18201b;
      --focus: #e3b34a;
      --warn-bg: #3a2614;
      --warn-ink: #f0b877;
      --on-accent: #141a16;
    }
  }
  :root[data-theme='dark'] {
    --ground: #141a16;
    --surface: #1c241f;
    --ink: #e6ece6;
    --muted: #9ba89f;
    --line: #2e3a33;
    --tea: #9dc08f;
    --tea-soft: #25331f;
    --pine: #e3b34a;
    --pine-strong: #e3b34a;
    --pine-soft: #3a2f14;
    --field: #18201b;
    --focus: #e3b34a;
    --warn-bg: #3a2614;
    --warn-ink: #f0b877;
    --on-accent: #141a16;
  }

  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font: 15px/1.5 var(--font-body);
    padding-inline: 16px;
    padding-block: calc(24px + env(safe-area-inset-top, 0px)) calc(96px + env(safe-area-inset-bottom, 0px));
  }
  h1, h2, h3 { font-family: var(--font-display); text-wrap: balance; margin: 0; }
  button, input, select { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

  .wrap { max-width: 780px; margin: 0 auto; display: grid; gap: 18px; }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
    display: grid;
    gap: 16px;
  }
  .card-head { display: grid; gap: 4px; }
  .card-head h2 { font-size: 20px; font-weight: 600; display: flex; align-items: center; gap: 10px; }
  .card-head p { margin: 0; color: var(--muted); font-size: 13px; }
  .step {
    font: 600 12px var(--font-mono);
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1px 6px;
  }
  .opt { font: 500 12px var(--font-body); color: var(--muted); }

  .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }

  label.f, .f {
    display: grid;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .box {
    display: flex;
    align-items: center;
    background: var(--field);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    transition: border-color 0.15s;
    min-height: 46px;
    text-transform: none;
    letter-spacing: 0;
  }
  .box:focus-within { border-color: var(--focus); }
  .box.anchor { border-color: var(--tea); }
  .box .pre, .box .unit { font: 500 14px var(--font-mono); color: var(--muted); padding: 0 10px; white-space: nowrap; }
  .box .pre { padding-right: 0; }
  .box input, .box select {
    flex: 1;
    min-width: 0;
    width: 100%;
    border: 0;
    background: transparent;
    outline: none;
    padding: 10px 12px;
    text-transform: none;
    letter-spacing: 0;
  }
  .box input[type='number'] { font: 600 19px var(--font-mono); font-variant-numeric: tabular-nums; }
  .box .pre + input { padding-left: 4px; }
  .box input[type='text'], .box select { font: 500 15px var(--font-body); color: var(--ink); }
  .box select { appearance: none; cursor: pointer; padding-right: 30px;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position: calc(100% - 16px) 50%, calc(100% - 11px) 50%;
    background-size: 5px 5px; background-repeat: no-repeat; }
  .box select option { color: #1c2620; background: #fff; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    border: 1.5px solid var(--line);
    background: var(--field);
    border-radius: 999px;
    padding: 6px 12px;
    font: 500 13px var(--font-body);
    cursor: pointer;
  }
  .chip[aria-pressed='true'] { background: var(--tea); border-color: var(--tea); color: var(--on-accent); }

  .btn {
    border: 1.5px solid var(--line);
    background: var(--field);
    border-radius: 10px;
    padding: 9px 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .btn.primary { background: var(--tea); border-color: var(--tea); color: var(--on-accent); }
  .btn.ghost { background: transparent; }
  .btn.danger { color: var(--warn-ink); }
  .btn:disabled { opacity: 0.45; cursor: not-allowed; }

  .toggle { display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 500; width: fit-content; user-select: none; }
  .toggle input { width: 18px; height: 18px; accent-color: var(--tea); }

  .out {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .out > div { flex: 1 1 150px; background: var(--tea-soft); padding: 12px 14px; display: grid; gap: 2px; align-content: start; }
  .out span { font-size: 12px; color: var(--muted); font-weight: 500; }
  .out b { font: 600 22px var(--font-mono); font-variant-numeric: tabular-nums; }
  .out b small { font-size: 13px; font-weight: 500; color: var(--muted); margin-left: 3px; }
  .out .hl b { color: var(--tea); }
  .out.pine > div { background: var(--pine-soft); }
  .out.pine .hl b { color: var(--pine); }

  .note { font-size: 13px; color: var(--muted); margin: 0; }
  .note.rule { border-top: 1px dashed var(--line); padding-top: 12px; }
  .warn { background: var(--warn-bg); color: var(--warn-ink); border-radius: 10px; padding: 10px 12px; font-size: 13px; margin: 0; }
  .mono { font-family: var(--font-mono); font-weight: 600; font-variant-numeric: tabular-nums; }

  details.research { border: 1px solid var(--line); border-radius: 10px; background: var(--field); }
  details.research > summary { cursor: pointer; padding: 10px 14px; font-weight: 600; font-size: 14px; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  details.research > summary::-webkit-details-marker { display: none; }
  details.research > summary::after { content: '+'; font-family: var(--font-mono); color: var(--muted); }
  details.research[open] > summary::after { content: '–'; }
  details.research .body { padding: 0 14px 14px; display: grid; gap: 10px; font-size: 14px; max-width: 68ch; }
  details.research .body p { margin: 0; }
  details.research ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
  details.research .src { font-size: 12px; color: var(--muted); }
  details.research a { color: var(--tea); }

  .table-wrap { overflow-x: auto; }
  table.t { border-collapse: collapse; width: 100%; font-size: 13px; }
  table.t th, table.t td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  table.t th { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
