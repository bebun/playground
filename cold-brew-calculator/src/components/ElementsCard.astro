  .el-head h3 { font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .el-head h3::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--pine-strong); }
  .seg { display: inline-flex; border: 1.5px solid var(--line); border-radius: 10px; overflow: hidden; flex-wrap: wrap; }
  .seg button { border: 0; background: var(--field); padding: 8px 12px; font-weight: 500; font-size: 13px; cursor: pointer; }
  .seg button + button { border-left: 1.5px solid var(--line); }
  .seg button[aria-pressed='true'] { background: var(--pine-strong); color: #1c1606; font-weight: 600; }
