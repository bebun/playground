---
---

<header class="app-head">
  <div class="brand">
    <h1>Cold Brew Calculator</h1>
    <p>Bean first, then brew, water and add-ons. Every number recalculates as you type.</p>
  </div>
  <nav class="tabs" aria-label="Views">
    <button type="button" class="tab" data-view="calc" aria-current="page">Calculator</button>
    <button type="button" class="tab" data-view="saved">Saved <span class="count" id="saved-count">0</span></button>
  </nav>
</header>

<style>
  .app-head { display: grid; gap: 14px; }
  .brand h1 { font-size: clamp(28px, 6vw, 40px); font-weight: 700; line-height: 1.05; letter-spacing: -0.01em; }
  .brand p { margin: 6px 0 0; color: var(--muted); max-width: 60ch; }
  .tabs { display: flex; gap: 4px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 4px; width: fit-content; }
  .tab { border: 0; background: transparent; border-radius: 9px; padding: 8px 16px; font-weight: 600; cursor: pointer; color: var(--muted); display: flex; gap: 8px; align-items: center; }
  .tab[aria-current='page'] { background: var(--tea); color: var(--on-accent); }
  .count { font: 600 12px var(--font-mono); background: var(--field); color: var(--ink); border-radius: 999px; padding: 0 7px; }
</style>
